{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "declaration": true,
    "isolatedModules": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "types": ["node", "jest"],
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "paths": {
      "@shared": ["../shared/src/index.ts"],
      "@shared/*": ["../shared/src/*"],
      "@src/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@common/*": ["./src/common/*"],
      "@decorators/*": ["./src/common/decorators/*"],
      "@guards/*": ["./src/common/guards/*"],
      "@interceptors/*": ["./src/common/interceptors/*"],
      "@modules/*": ["./src/modules/*"],
      "@auth/*": ["./src/modules/auth/*"],
      "@characters/*": ["./src/modules/characters/*"],
      "@teams/*": ["./src/modules/teams/*"],
      "@users/*": ["./src/modules/users/*"],
      "@equipments/*": ["./src/modules/equipmets"],
      "@inventories/*": ["./src/modules/inventories/*"],
      "@mails/*": ["./src/modules/mails/*"]
    }
  },
  "include": [
    "src/**/*",
    "src/modules/characters/charactersCompute.interceptor.ts"
  ]
}
