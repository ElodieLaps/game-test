### USER ###

### all users
GET http://localhost:3000/user/all

### user by id
GET http://localhost:3000/user/{{userId}}

### create user
POST http://localhost:3000/user
Content-Type: application/json

{
    "name": "Elo",
    "password": "elotest",
    "email": "elo@gmail.com"
}

### delete user
DELETE http://localhost:3000/user/{{userId}}
Authorization: Bearer {{token}}

### AUTH ###

### login
POST http://localhost:3000/login
Content-Type: application/json

{
    "email": "elo@gmail.com",
    "password": "elotest"
}

### get current user
GET http://localhost:3000/user
Authorization: Bearer {{token}}

### CHARACTER ###

### create character
POST http://localhost:3000/character
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Hugo",
    "race": "ELF",
    "role": "WARRIOR",
    "gender": "MALE",
    "customStatistics": {
        "STRENGTH": 5,
        "HEALTH": 4,
        "MANA": 3,
        "ARMOR": 2,
        "DODGE": 1
    }
}

### get all characters
GET http://localhost:3000/character
Authorization: Bearer {{token}}

### get character by id
GET http://localhost:3000/character/{{characterId}}
Authorization: Bearer {{token}}

### delete character
DELETE http://localhost:3000/character/{{characterId}}
Authorization: Bearer {{token}}

### add character equipments
PUT http://localhost:3000/character/{{characterId}}/equipments/add
Authorization: Bearer {{token}}
Content-Type: application/json

["SAUCEPAN", "WOODEN_SPOON", "SAUCEPAN_LID"]

### remove character equipments
PUT http://localhost:3000/character/{{characterId}}/equipments/remove
Authorization: Bearer {{token}}
Content-Type: application/json

["HEAD", "SHIELD"]

### remove all character equipments
PUT http://localhost:3000/character/{{characterId}}/equipments/removeAll
Authorization: Bearer {{token}}

### TEAM ###

### create team
POST http://localhost:3000/team
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Les Bests"
}

### delete team
DELETE http://localhost:3000/team/{{teamId}}
Authorization: Bearer {{token}}

### get all teams
GET http://localhost:3000/team
Authorization: Bearer {{token}}

### get team by id
GET http://localhost:3000/team/{{teamId}}
Authorization: Bearer {{token}}

### add characters to team
PUT http://localhost:3000/team/{{teamId}}/addCharacters
Authorization: Bearer {{token}}
Content-Type: application/json

[
    "{{characterId1}}",
    "{{characterId2}}"
]

### remove characters from team
PUT http://localhost:3000/team/{{teamId}}/removeCharacters
Authorization: Bearer {{token}}
Content-Type: application/json

[
    "{{characterId1}}",
    "{{characterId2}}"
]

### INVENTORY ###

### get inventory
GET http://localhost:3000/inventory/{{userId}}
Authorization: Bearer {{token}}

### add items to user inventory
POST http://localhost:3000/inventory/add
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "ownerId": "{{userId}}",
    "ownerType": "USER",
    "equipments": [{ "name": "SAUCEPAN", "quantity": 1 }],
    "consumables": []
}

### add items to team inventory
POST http://localhost:3000/inventory/add
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "ownerId": "{{teamId}}",
    "ownerType": "TEAM",
    "equipments": [{ "name": "SAUCEPAN", "quantity": 1 }],
    "consumables": []
}

### remove items
DELETE http://localhost:3000/inventory/remove
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "ownerId": "{{userId}}",
    "equipments": [{ "name": "SAUCEPAN", "quantity": 1 }],
    "consumables": []
}

### transfer items from user to team
PUT http://localhost:3000/inventory/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "fromId": "{{userId}}",
    "toId": "{{teamId}}",
    "toOwnerType": "TEAM",
    "equipments": [{ "name": "SAUCEPAN", "quantity": 1 }],
    "consumables": []
}

### transfer items from team to user
PUT http://localhost:3000/inventory/transfer
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "fromId": "{{teamId}}",
    "toId": "{{userId}}",
    "toOwnerType": "TEAM",
    "equipments": [{ "name": "SAUCEPAN", "quantity": 6}],
    "consumables": []
}